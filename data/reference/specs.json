 "gpu": {
  "$comment": "依 GPU 晶片的參考功耗推定，非公版超頻卡可能更高，因此來源標為 inferred（介面會註明「依推定規格」）。同晶片有多種版本時取最高值。",
  "source": "inferred",
  "rules": [
   {"match": "RTX\\s?5090", "specs": {"board_power_w": {"value": 575, "note": "NVIDIA RTX 5090 參考 TGP"}, "power_connectors": {"value": ["12V-2x6"], "note": "RTX 5070 以上使用 12V-2x6"}}},
   {"match": "RTX\\s?5080", "specs": {"board_power_w": {"value": 360, "note": "NVIDIA RTX 5080 參考 TGP"}, "power_connectors": {"value": ["12V-2x6"], "note": "RTX 5070 以上使用 12V-2x6"}}},
   {"match": "RTX\\s?5070\\s?Ti", "specs": {"board_power_w": {"value": 300, "note": "NVIDIA RTX 5070 Ti 參考 TGP"}, "power_connectors": {"value": ["12V-2x6"], "note": "RTX 5070 以上使用 12V-2x6"}}},
   {"match": "RTX\\s?5070", "specs": {"board_power_w": {"value": 250, "note": "NVIDIA RTX 5070 參考 TGP"}, "power_connectors": {"value": ["12V-2x6"], "note": "RTX 5070 以上使用 12V-2x6"}}},
   {"match": "RTX\\s?5060\\s?Ti", "specs": {"board_power_w": {"value": 180, "note": "NVIDIA RTX 5060 Ti 參考 TGP（8GB／16GB 相同）"}}},
   {"match": "RTX\\s?5060", "specs": {"board_power_w": {"value": 145, "note": "NVIDIA RTX 5060 參考 TGP"}}},
   {"match": "RTX\\s?5050", "specs": {"board_power_w": {"value": 130, "note": "NVIDIA RTX 5050 參考 TGP"}}},
   {"match": "RTX\\s?3060", "specs": {"board_power_w": {"value": 170, "note": "NVIDIA RTX 3060 12GB 參考 TGP"}}},
   {"match": "RTX\\s?3050.*(?<!\\d)6\\s?G", "specs": {"board_power_w": {"value": 70, "note": "NVIDIA RTX 3050 6GB 參考 TGP"}}},
   {"match": "RTX\\s?3050", "specs": {"board_power_w": {"value": 130, "note": "NVIDIA RTX 3050 8GB 參考 TGP（未標容量者取較高的 8GB 版）"}}},
   {"match": "GT\\s?1030", "specs": {"board_power_w": {"value": 30, "note": "NVIDIA GT 1030 GDDR5 版 30 W（DDR4 版較低）"}}},
   {"match": "GT\\s?730|N730", "specs": {"board_power_w": {"value": 49, "note": "NVIDIA GT 730 各版本最高 49 W"}}},
   {"match": "GT\\s?710|N710", "specs": {"board_power_w": {"value": 19, "note": "NVIDIA GT 710 參考功耗"}}},
   {"match": "GT\\s?210|N210", "specs": {"board_power_w": {"value": 31, "note": "NVIDIA GT 210 參考功耗"}}},
   {"match": "RX\\s?9070\\s?XT", "specs": {"board_power_w": {"value": 304, "note": "AMD RX 9070 XT 參考 TBP"}}},
   {"match": "RX\\s?9070\\s?GRE", "specs": {"board_power_w": {"value": 220, "note": "AMD RX 9070 GRE 參考 TBP"}}},
   {"match": "RX\\s?9070", "specs": {"board_power_w": {"value": 220, "note": "AMD RX 9070 參考 TBP"}}},
